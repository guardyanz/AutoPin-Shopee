{
  "manifest_version": 3,
  "name": "PinShop",
  "short_name": "PinShop",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Siapkan produk Shopee Affiliate, tinjau satu batch Pin, lalu publikasikan melalui Pinterest API v5.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "offscreen",
    "identity",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://affiliate.shopee.co.id/*",
    "https://*.shopee.co.id/*",
    "https://*.shopee.sg/*",
    "https://*.susercontent.com/*",
    "https://api.pinterest.com/*",
    "https://api-sandbox.pinterest.com/*",
    "https://*.workers.dev/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Buka PinShop",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://affiliate.shopee.co.id/*",
        "https://*.shopee.co.id/*"
      ],
      "js": ["src/content/shopee.ts"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://*.shopee.co.id https://*.shopee.sg; connect-src https://*.shopee.co.id https://*.shopee.sg https://*.susercontent.com https://api.pinterest.com https://api-sandbox.pinterest.com https://*.workers.dev https://api.openai.com https://openrouter.ai https://generativelanguage.googleapis.com"
  }
}
