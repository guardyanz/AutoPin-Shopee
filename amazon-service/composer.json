{
  "name": "wardiyan/autopin-amazon-service",
  "description": "Private Amazon Creators API adapter for AutoPin Shopee",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.9",
    "tims/amazon-creatorsapi-php-sdk": "^1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "AutoPin\\Amazon\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AutoPin\\Amazon\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@php -l public/index.php",
      "@php -l src/AmazonCreatorsClient.php",
      "@php -l src/CachedDefaultApi.php",
      "@php -l src/FileTokenManager.php",
      "@php -l src/ProductMapper.php",
      "@php -l src/RequestValidator.php"
    ],
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "sort-packages": true
  }
}
